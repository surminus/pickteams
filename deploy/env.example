# Copy to /etc/pickteams/env, owned by root and readable only by root, then
# put a long password in it. The service will not start without one.
#
#   install -D -m 0600 deploy/env.example /etc/pickteams/env
#   systemd-creds --help  # if you would rather not have it in a file at all
#
# Generate something with: openssl rand -base64 24
PICKTEAMS_ADMIN_PASSWORD=
